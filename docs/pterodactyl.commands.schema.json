{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pterodactyl.commands.json",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "root"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "paper",
            "spigot",
            "folia",
            "fabric",
            "quilt",
            "forge",
            "neoforge",
            "velocity",
            "other"
          ]
        },
        "minecraft": {
          "type": "string"
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "root": {
      "type": "object",
      "required": [
        "children"
      ],
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "type": {
          "enum": [
            "literal",
            "argument"
          ],
          "default": "literal"
        },
        "parser": {
          "type": "string"
        },
        "suggestions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "maxLength": 199
          }
        },
        "aliases": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          }
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "permission": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        },
        "redirect": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    }
  }
}

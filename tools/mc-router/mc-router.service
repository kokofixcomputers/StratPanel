[Unit]
Description=Minecraft router (custom domains for Pterodactyl servers)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/mc-router.env
ExecStart=/usr/local/bin/mc-router
Restart=always
RestartSec=3
# Needed to listen on the default Minecraft port when not running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

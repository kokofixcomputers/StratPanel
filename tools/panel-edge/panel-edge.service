[Unit]
Description=Panel edge (HTTPS for the panel with the certificates added in it)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/panel-edge.env
ExecStart=/usr/local/bin/panel-edge
Restart=always
RestartSec=3
# Needed to listen on port 443 when not running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
DynamicUser=yes
# The last certificates are kept here (private keys: only this service can read it).
StateDirectory=panel-edge
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

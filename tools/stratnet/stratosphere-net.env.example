# One file for both parts. Each is on when it has its secret, or switched on and off here:
# ENABLE_ROUTER=1
# ENABLE_EDGE=1

# ---- the router: Minecraft connections for the custom domains of servers --------------------------------------------------------
# Where the panel is (the router asks it for the domains; PANEL_URL is used when this is not set), and the secret that matches
# PTERODACTYL_DOMAINS_ROUTER_TOKEN in the panel's .env
ROUTER_PANEL_URL=https://panel.example.com
ROUTER_TOKEN=change-me
# Port players connect to. 25565 is what lets a domain work without typing a port.
ROUTER_LISTEN=:25565
# How often the list of domains is refreshed.
ROUTER_REFRESH=15s
# Set to 1 to send a PROXY protocol v1 header to the backend so it can see the real player IP.
# Only enable this if the backend servers expect it (for example Velocity with haproxy-protocol = true).
PROXY_PROTOCOL=0
# Messages shown in the server list and when joining while a server cannot be reached. Use \n for a second line.
# UNKNOWN_MOTD=§cNo server is set up for this address.
# OFFLINE_MOTD=§eThis server is off.\n§7Come back once it has been started.
# STARTING_MOTD=§aThis server is starting...\n§7See you soon!
# STOPPING_MOTD=§eThis server is shutting down.\n§7Try again in a moment.
# SUSPENDED_MOTD=§cThis server is suspended.\n§7Contact the owner or an administrator.
# INSTALLING_MOTD=§eThis server is being set up.\n§7Check back soon.
# For servers with auto sleep on: shown while the server is asleep, and when a player joins and it is being woken up.
# SLEEPING_MOTD=§bThis server is asleep.\n§7Join to wake it up.
# WAKING_MOTD=§aWaking the server up...\n§7Join again in about a minute.

# ---- the edge: the panel over https with the certificates added in the panel -----------------------------------------------------
# Where the panel is for the edge (EDGE_PANEL_URL, or PANEL_URL when it is not set; use http://127.0.0.1 on the same machine or an https
# address, never plain http over a network: the answer holds private keys), and the secret that matches PTERODACTYL_CERTIFICATES_TOKEN.
EDGE_PANEL_URL=http://127.0.0.1
EDGE_TOKEN=change-me
# The HTTPS port to listen on.
EDGE_LISTEN=:443
# The web server that runs the panel (nginx or Apache on its own port or on 127.0.0.1:80).
BACKEND=http://127.0.0.1:80
# The http port: names that have a certificate are sent to https, and Let's Encrypt is answered (free certificates for the domains of
# servers). Empty: no http. The web server of the panel must not use the same port, move it (BACKEND) to 127.0.0.1:8081 for example.
HTTP_LISTEN=
# How often the certificates are asked for again (10s or more).
EDGE_REFRESH=60s
# Add the Strict-Transport-Security header, in seconds (0 = off). Only once https works everywhere.
HSTS_SECONDS=0
